{
  "name": "mkt-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "seed": "tsx --env-file=.env.local src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "user": "tsx --env-file=.env.local src/db/create-user.ts",
    "invite": "tsx --env-file=.env.local src/db/invite-team.ts",
    "mail:teste": "tsx --env-file=.env.local src/db/send-test-mail.ts",
    "dev:setup": "tsx --env-file=.env.local src/db/setup-dev.ts",
    "rotinas:importar": "tsx --env-file=.env.local src/db/import-routines.ts",
    "metas": "tsx --env-file=.env.local src/db/set-goals.ts",
    "clickup:importar": "tsx --env-file=.env.local src/db/import-clickup.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "nodemailer": "^9.0.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
