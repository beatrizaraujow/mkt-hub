# ---------------------------------------------------------------------------
# Banco — Supabase
# Painel do Supabase > Project Settings > Database > Connection string
# Crie o projeto na regiao South America (Sao Paulo).
# ---------------------------------------------------------------------------

# Aplicacao: Transaction pooler, porta 6543.
# E o que aguenta serverless. O driver ja usa prepare:false por causa dele.
DATABASE_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Migrations (`db:push`, `db:generate`): Session pooler, porta 5432.
# DDL nao roda bem pelo pooler de transacao — por isso as duas strings.
DIRECT_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Sessao
# ---------------------------------------------------------------------------

# Chave que assina o cookie. Minimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Primeiro acesso — lido so pelo `npm run seed`
# ---------------------------------------------------------------------------

SEED_ADMIN_NAME="Anny"
SEED_ADMIN_EMAIL="mkt.quatro5@gmail.com"
SEED_ADMIN_PASSWORD=""
