# ---------------------------------------------------------------------------
# Banco — Supabase
# Painel do Supabase > Project Settings > Database > Connection string
# Crie o projeto na regiao South America (Sao Paulo).
# ---------------------------------------------------------------------------

# Aplicacao: Transaction pooler, porta 6543.
# E o que aguenta serverless. O driver ja usa prepare:false por causa dele.
DATABASE_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Migrations (`db:push`, `db:generate`): Session pooler, porta 5432.
# DDL nao roda bem pelo pooler de transacao — por isso as duas strings.
DIRECT_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Storage dos anexos — Supabase, Project Settings > API
# Sem estas duas, link funciona e upload de arquivo fica desligado.
# ---------------------------------------------------------------------------

SUPABASE_URL="https://SEUPROJETO.supabase.co"
# chave service_role. So no servidor, nunca no navegador.
SUPABASE_SERVICE_KEY=""

# ---------------------------------------------------------------------------
# Sessao
# ---------------------------------------------------------------------------

# Chave que assina o cookie. Minimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Primeiro acesso — lido so pelo `npm run seed`
# ---------------------------------------------------------------------------

SEED_ADMIN_NAME="Anny"
SEED_ADMIN_EMAIL="mkt.quatro5@gmail.com"
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Cron do revisor de entregas
# A Vercel manda `Authorization: Bearer <valor>` na rota /api/cron/review.
# Sem esta variavel a rota recusa em vez de abrir.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------------------------

CRON_SECRET=""

# ---------------------------------------------------------------------------
# Envio de e-mail (SMTP)
# Sem estas quatro, o convite continua funcionando: ele so nao sai daqui, e a
# tela mostra o link para entregar na mao. Falha de envio nunca perde acesso.
#
# A CASA TEM DOIS PROVEDORES, UM POR DOMINIO. Confira o MX antes de supor:
#   @grupoquatro5.com -> Google Workspace -> smtp.gmail.com
#   @seubone.com      -> Zoho Mail        -> smtp.zoho.com
# Usar o servidor do outro da 535 (a conta nao existe la) e, se passasse,
# o SPF do dominio nao autoriza o remetente e a mensagem cai em spam.
#
# A senha NAO e a do login. Com verificacao em duas etapas ligada os dois
# provedores recusam a senha da conta no SMTP — gere senha de aplicativo:
#   Google -> myaccount.google.com/apppasswords
#   Zoho   -> Zoho Account > Security > App Passwords
# Ela vale so para isto e pode ser revogada sozinha, sem derrubar o acesso
# de ninguem ao e-mail.
#
# Confira antes de depender:  npm run mail:teste -- --so-verificar
# ---------------------------------------------------------------------------

SMTP_HOST="smtp.gmail.com"
# 465 fala SSL do primeiro byte; 587 abre em claro e sobe no STARTTLS.
SMTP_PORT="465"
SMTP_USER="anny.beatriz@grupoquatro5.com"
SMTP_PASSWORD=""

# O remetente precisa ser a conta autenticada ou um alias verificado nela.
# Deixe vazio para usar o proprio SMTP_USER.
MAIL_FROM="MKT Hub <anny.beatriz@grupoquatro5.com>"

# ---------------------------------------------------------------------------
# Endereco publico do sistema
# So para montar link que sai daqui (convite por e-mail). No navegador o
# proprio cabecalho da requisicao resolve; num e-mail nao ha requisicao.
# Nao use a URL do deploy (mkt-hub-abc123.vercel.app): ela muda a cada
# publicacao, e um convite de 7 dias apontando para la morre no deploy seguinte.
#
# DEIXE VAZIO EM DESENVOLVIMENTO. Preenchida aqui, ela manda o link do convite
# para producao — e o token so existe no banco de desenvolvimento, entao o link
# abre uma pagina que diz "convite invalido". Vazia, o cabecalho da requisicao
# resolve o localhost sozinho. Em producao o valor vive na Vercel:
#   https://www.mkthub.space
# ---------------------------------------------------------------------------

APP_URL=""
